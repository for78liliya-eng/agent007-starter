# Настройки связи агента с Telegram.
#
# Как пользоваться: попросите агента в чате Claude Code
#   «создай secrets/channel.env по образцу secrets/channel.env.example
#    и впиши мой токен и мой ID» — он сделает сам.
# Файл channel.env остаётся только у вас: в git и в бэкап он не попадает.

# Токен бота от @BotFather. Вид: 1234567890:AAH...длинная-строка
TELEGRAM_BOT_TOKEN=

# Цифры из начала токена, до двоеточия. Пример: для 1234567890:AAH... — 1234567890
TELEGRAM_EXPECTED_BOT_ID=

# Ваш числовой Telegram ID (узнать — написать боту @userinfobot).
# Агент отвечает только этому человеку.
TELEGRAM_ALLOWED_USER_IDS=

# Короткое имя агента латиницей, без пробелов. Например: coder
AGENT_ID=coder

# Запись диалогов в файлы. Пока не трогайте: память агента и так работает через папку core.
TELEGRAM_MEMORY_ENABLED=false

# Голосовые сообщения: бесплатный ключ Groq (урок про голосовые). Пока можно оставить пустым.
GROQ_API_KEY=

# Остальное start.sh заполняет сам: папку агента и папку служебных файлов.
# Менять не нужно, если не знаете зачем.
# TELEGRAM_WORKSPACE_ROOT=
# TELEGRAM_STATE_DIR=
